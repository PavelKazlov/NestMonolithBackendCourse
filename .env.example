# Скопируйте в .env и при необходимости поменяйте значения: cp .env.example .env
# .env в git не попадает — там будут секреты.

# Server options
PORT=3007
NODE_ENV=development
COOKIE_SECRET=my-secret
# Уровень логов pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# OpenAPI/Swagger UI на /docs. В production по умолчанию выключен.
SWAGGER_ENABLED=true

# Health check
HEALTH_CHECK_ENABLED=false

# Throttler
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=true

# Mail (SMTP). Локально — Mailpit из docker-compose, письма видны на http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Backend Course <no-reply@example.test>"
