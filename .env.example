# Скопируйте в .env и при необходимости поменяйте значения: cp .env.example .env
# .env в git не попадает — там будут секреты.

# Server options
PORT=3007
NODE_ENV=development
COOKIE_SECRET=my-secret
# Уровень логов pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# OpenAPI/Swagger UI на /docs. В production по умолчанию выключен.
SWAGGER_ENABLED=true

# Health check
HEALTH_CHECK_ENABLED=false

# Throttler
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=true

# Mail (SMTP). Локально — Mailpit из docker-compose, письма видны на http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Backend Course <no-reply@example.test>"

# Ключ HMAC для кодов и токенов из писем. Обязателен, минимум 32 символа.
# Сгенерировать свой: openssl rand -base64 48
CHALLENGE_HMAC_KEY=change-me-to-a-random-string-of-at-least-32-chars

# Registration (1.0)
# Подтверждение email при регистрации: true — нужен код или ссылка из письма.
REGISTRATION_CONFIRMATION_ENABLED=true
# Способ подтверждения: otp | magic_link
REGISTRATION_CONFIRMATION_METHOD=otp
# Страница фронтенда для magic link. Токен добавляется как #token=...
REGISTRATION_CONFIRM_URL=http://localhost:5174/register/confirm
# Rate limit на register и resend: запросов с одного IP за окно (мс)
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_TTL=60000

# Authentication (1.2)
# Ключи: обязательны, не короче 32 байт, все разные. Заглушки ниже приложение отвергнет.
# Сгенерировать: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-jwt-access-secret-of-at-least-32-chars
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret-of-at-least-32-chars
LOGIN_CHALLENGE_HMAC_KEY=change-me-login-challenge-key-of-at-least-32-chars
AUDIT_HMAC_KEY=change-me-audit-hmac-key-of-at-least-32-chars
# Claims iss и aud: одинаковые при выпуске и проверке JWT
JWT_ISSUER=backend-course-api
JWT_AUDIENCE=backend-course-web
# Подтверждение входа через email: false — cookies сразу после пароля
LOGIN_EMAIL_CONFIRMATION_ENABLED=false
# Способ подтверждения входа: otp | magic_link
LOGIN_EMAIL_CONFIRMATION_METHOD=otp
# Страница фронтенда для magic link входа. Токен добавляется как #token=...
LOGIN_CONFIRM_URL=http://localhost:5174/login/confirm
# Собственный origin API (same-origin POST без CSRF-заголовка)
APP_ORIGIN=http://localhost:3007
# Доверенные frontend-origin через запятую: CORS + обязательный X-CSRF-Protection: 1
TRUSTED_ORIGINS=http://localhost:5174
# SameSite auth-cookie: strict (frontend на том же site) | none (другой site)
AUTH_COOKIE_SAME_SITE=strict
# Rate limit (спека 1.6): 30 запросов с IP за минуту на login и refresh
LOGIN_RATE_LIMIT=30
LOGIN_RATE_TTL=60000
REFRESH_RATE_LIMIT=30
REFRESH_RATE_TTL=60000
