# Окружение для e2e-тестов: отдельная БД app_test, тихие логи, высокий глобальный лимит.
# Подгружается в test/setup-env.ts и перекрывает значения из .env.

# Server options
PORT=3007
NODE_ENV=development
COOKIE_SECRET=my-secret
# Уровень логов pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=silent
# OpenAPI/Swagger UI на /docs. В production по умолчанию выключен.
SWAGGER_ENABLED=true

# Health check
HEALTH_CHECK_ENABLED=false

# Throttler
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=1000

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_test
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=true

# Mail (SMTP). Локально — Mailpit из docker-compose, письма видны на http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Backend Course <no-reply@example.test>"
